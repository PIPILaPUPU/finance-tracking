# Copy to .env on the server:
#   cp .env.example .env
#   nano .env

# Port for Caddy/nginx reverse proxy (keep 8080 behind HTTPS proxy)
WEB_HOST_PORT=8080

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=finance_tracker

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32PLUS
JWT_ISSUER=auth-app

# true when site is served over HTTPS (fin-tracker.su via Caddy)
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
